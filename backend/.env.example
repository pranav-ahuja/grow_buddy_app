# Copy this file to .env and adjust. .env is git-ignored.

# --- Environment ------------------------------------------------------------
# "development" (or "dev"/"local") enables the dev-only settings below.
# Anything else — staging, production — makes the server refuse to start if one
# of them is still on.
ENVIRONMENT=development

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset the app generates a random key at startup, which means every
# restart invalidates all existing tokens (fine for local dev, not for prod).
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---------------------------------------------------------------
# Default is SQLite so the backend runs with zero setup.
# Switch to PostgreSQL by installing psycopg (see requirements.txt) and using:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/growbuddy
DATABASE_URL=sqlite:///./growbuddy.db

# --- Google Sign-In ---------------------------------------------------------
# Comma-separated OAuth client IDs from Google Cloud Console. A sign-in is only
# accepted if the ID token was minted for one of these, so put every platform's
# client ID here (the Web client id is the one Android sends as serverClientId).
# Leave empty and POST /auth/google returns a clear "not configured" 401.
GOOGLE_CLIENT_IDS=

# --- OTP --------------------------------------------------------------------
# While true, the OTP is returned in the API response and printed to the server
# log so you can test phone login without an SMS provider.
# Only allowed while ENVIRONMENT is development — the server refuses to start
# otherwise, because anyone could then request a code for a number they do not
# own and read it out of the response.
OTP_DEBUG_RETURN=true
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
