<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks plain HTTP by default, which would make every call to the
  local backend fail with a bare "connection failed". This file re-allows it for
  development hosts only, and it lives in src/debug so release builds keep the
  strict HTTPS-only default.

  Add your own machine's LAN IP here if it differs.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Android emulator's alias for the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Development machine on the LAN, matches kApiBaseUrl -->
        <domain includeSubdomains="false">192.168.0.157</domain>
    </domain-config>
</network-security-config>
